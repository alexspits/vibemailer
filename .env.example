# Скопируйте в .env и заполните. Файл .env в .gitignore — секреты только там.
#
# Здесь лежит то, что глобально на всё приложение. Список VPN-серверов сюда не
# помещается: панели у них разные и настройки у каждой свои, поэтому он живёт
# отдельным YAML-файлом (см. servers.example.yml), а тут только путь к нему.

# --- SMTP (отправитель на всё приложение) ---
# Gmail — smtp.gmail.com:587 с TLS, Яндекс — smtp.yandex.ru:465 с SSL.
# Пароль нужен именно от приложения (Gmail: App Password, Яндекс: пароль
# приложения); основной пароль от ящика SMTP не примет.
# Проверить доступ, ничего не отправляя: make check_smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Лимиты отправки ---
# RETRIES — попыток на одно письмо при временных ошибках почты.
# DEFAULT_DELAY — пауза между письмами в секундах: рассылка не должна выглядеть
# для почтового сервера как всплеск.
RETRIES=3
DEFAULT_DELAY=2.0

# --- База данных (SQLite) ---
DATABASE_URL=sqlite:///./vibe_mail.db

# --- Список VPN-серверов ---
VPN_SERVERS_FILE=servers.yml

# --- Поднятие новых серверов (ansible) ---
# Сценарии лежат в самом репозитории (каталог ansible/) и едут в образ, поэтому
# менять путь нужно только если у вас свой набор ролей. Пусто — кнопка «Поднять новый
# сервер» на странице «Серверы» выключена, остаётся «Подключить готовый».
ANSIBLE_DIR=ansible
# Логи прогонов. В контейнере перекрывается на /data/provision — каталог приложения
# принадлежит root, и писать туда процесс не может.
PROVISION_DIR=data/provision
# Предел на один прогон плейбука, минут.
PROVISION_TIMEOUT_MIN=60
# Кем и на каком порту будут жить поднятые серверы — форма подставит это, а прогон
# получит явным -e. Пусто — взять из ansible/group_vars/all.yml, где умолчания
# нейтральные (admin и 22): каталог лежит в публичном репозитории, личные значения
# держим здесь.
PROVISION_ADMIN_USER=
PROVISION_SSH_PORT=

# --- CORS (origin фронта в dev; через запятую) ---
CORS_ORIGINS=http://localhost:5173
